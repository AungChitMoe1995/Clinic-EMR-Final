# EASY EMR - Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

SECRET_KEY=replace-with-a-random-64-char-hex-key
FLASK_ENV=development

# Database Selection (0 = Local SQLite in database/emr.sqlite3, 1 = MySQL/MariaDB)
USE_MARIADB=0

# MySQL / MariaDB Credentials (only required when USE_MARIADB=1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_emr
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# SFTP Deployment Credentials (only required when running deploy_to_waifly.py)
WAIFLY_SFTP_HOST=your.sftp.server.com
WAIFLY_SFTP_PORT=2022
WAIFLY_SFTP_USER=your_sftp_username
WAIFLY_SFTP_PASS=your_sftp_password

# Allow first-owner registration only on a new, private installation. Disable after setup.
ALLOW_CLINIC_REGISTRATION=0
# Enable for an HTTPS production deployment.
SESSION_COOKIE_SECURE=0
# Optional fictitious demo accounts: all four distinct, at least 12 characters.
# SEED_CLINIC_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_RECEPTION_PASSWORD=
# SEED_DOCTOR_PASSWORD=
